<file path="style.css">
/* =========================================================
   NOTEVORA / STUDIORA
   Global Stylesheet
   ========================================================= */

/* =========================================================
   Theme
   ========================================================= */

:root {
  --primary: #4f46e5;
  --primary-hover: #4338ca;
  --primary-light: #eef2ff;

  --bg-color: #f8fafc;
  --card-bg: #ffffff;

  --text-main: #0f172a;
  --text-muted: #64748b;

  --border: #dbe3ef;

  --success-bg: #dcfce7;
  --success-text: #15803d;

  --danger-bg: #fee2e2;
  --danger-text: #b91c1c;

  --term-bg: #fef08a;
  --term-text: #713f12;
  --term-border: #eab308;

  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.08);

  --radius-lg: 16px;
  --radius-md: 10px;
}

[data-theme="dark"] {
  --primary: #818cf8;
  --primary-hover: #a5b4fc;
  --primary-light: #1c2740;

  --bg-color: #090d16;
  --card-bg: #131b2e;

  --text-main: #f1f5f9;
  --text-muted: #a7b4c8;

  --border: #2b3955;

  --success-bg: #12351f;
  --success-text: #86efac;

  --danger-bg: #3b171b;
  --danger-text: #fca5a5;

  --term-bg: #422006;
  --term-text: #fef08a;
  --term-border: #a16207;

  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.6);
}

/* =========================================================
   Reset / Base
   ========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: "Plus Jakarta Sans", sans-serif;
  -webkit-tap-highlight-color: transparent;
}

html {
  min-height: 100%;
}

body {
  min-height: 100vh;
  padding-bottom: 90px;
  background: var(--bg-color);
  color: var(--text-main);
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.hidden {
  display: none !important;
}

.material-symbols-outlined {
  font-variation-settings:
    "FILL" 0,
    "wght" 400,
    "GRAD" 0,
    "opsz" 24;
  vertical-align: middle;
  font-size: 20px;
}

/* =========================================================
   Header
   ========================================================= */

.top-bar {
  position: sticky;
  top: 0;
  z-index: 60;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  padding: 12px 16px;

  background: var(--card-bg);
  border-bottom: 1px solid var(--border);

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 10px;

  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.header-text {
  display: flex;
  flex-direction: column;

  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.header-text h1 {
  max-width: 100%;

  font-size: 1.15rem;
  font-weight: 700;
  line-height: 1.25;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-text span {
  margin-top: 1px;

  color: var(--text-muted);
  font-size: 0.72rem;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-right {
  position: relative;

  display: flex;
  align-items: center;
  gap: 6px;

  flex-shrink: 0;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  padding: 8px;

  background: var(--primary-light);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);

  cursor: pointer;
}

.header-action {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  padding: 7px 11px;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 999px;

  font-size: 0.72rem;
  font-weight: 700;

  cursor: pointer;
}

.header-action:hover {
  background: var(--primary-light);
  color: var(--primary);
}

.header-more-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: 100;

  width: 190px;
  padding: 6px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: 12px;

  box-shadow: var(--shadow-md);
}

.header-more-menu button {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 10px 9px;

  background: transparent;
  color: var(--text-main);

  border: 0;
  border-radius: 8px;

  text-align: left;
  font-size: 0.76rem;

  cursor: pointer;
}

.header-more-menu button:hover {
  background: var(--primary-light);
  color: var(--primary);
}

/* =========================================================
   Search
   ========================================================= */

.search-bar-wrap {
  position: sticky;
  top: 69px;
  z-index: 55;

  padding: 10px 16px 8px;

  background: var(--bg-color);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 8px;

  max-width: 900px;
  margin: auto;
}

.search-box {
  position: relative;

  display: flex;
  align-items: center;
  gap: 8px;

  flex: 1;

  padding: 6px 12px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.search-box input {
  width: 100%;
  padding-right: 38px;

  background: transparent;
  color: var(--text-main);

  border: 0;
  outline: none;

  font-size: 0.9rem;
}

.search-clear-btn {
  position: absolute;
  right: 6px;

  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: transparent;
  color: var(--text-muted);

  border: 0;
  border-radius: 50%;

  cursor: pointer;
}

.search-clear-btn:hover {
  background: var(--primary-light);
  color: var(--primary);
}

.search-tools {
  display: flex;
  gap: 5px;
}

.search-tool-wrap {
  position: relative;
}

.search-tool-btn {
  background: var(--card-bg);
  border: 1px solid var(--border);
}

.search-popover {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: 80;

  width: 210px;
  padding: 8px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: 16px;

  box-shadow: 0 18px 48px rgba(15, 23, 42, 0.14);

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.search-menu-section {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.search-menu-section + .search-menu-section {
  margin-top: 7px;
  padding-top: 7px;

  border-top: 1px solid var(--border);
}

.search-menu-section strong {
  padding: 5px 8px;

  color: var(--text-muted);
  font-size: 0.7rem;
}

.search-menu-section button {
  padding: 8px;

  background: transparent;
  color: var(--text-main);

  border: 0;
  border-radius: 7px;

  text-align: left;
  font-size: 0.8rem;

  cursor: pointer;
}

.search-menu-section button:hover,
.search-menu-section button.selected {
  background: var(--primary-light);
  color: var(--primary);
}

.active-search-chips {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;

  max-width: 900px;
  margin: 2px auto 0;
}

.active-search-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  padding: 5px 8px 5px 9px;

  background: var(--primary-light);
  color: var(--primary);

  border: 1px solid var(--border);
  border-radius: 999px;

  font-size: 0.68rem;
  font-weight: 700;

  cursor: pointer;
}

.active-search-chip .material-symbols-outlined {
  font-size: 15px;
}

.active-search-chip .chip-close {
  opacity: 0.75;
}

.active-search-chip:hover {
  background: var(--card-bg);
}

/* =========================================================
   General Lists / Cards
   ========================================================= */

.app-view {
  padding: 0 16px;
}

.view-panel {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.subjects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 12px;
}

.subject-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.section-label {
  padding: 4px 2px;

  color: var(--text-muted);

  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.subject-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14px;

  min-height: 120px;
  padding: 16px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: var(--radius-lg);

  box-shadow: var(--shadow-sm);

  cursor: pointer;
}

.subject-card-main {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.subject-card .icon-tag {
  width: 36px;
  height: 36px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  background: var(--primary-light);
  color: var(--primary);

  border-radius: var(--radius-md);
}

.subject-title-row {
  min-width: 0;

  display: flex;
  flex-direction: column;
  gap: 5px;
}

.subject-title-row h3 {
  margin: 0;

  font-size: 0.95rem;
  font-weight: 700;
}

.subject-level {
  color: var(--text-muted);

  font-size: 0.68rem;
  font-weight: 600;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.subject-card-meta,
.subject-detail-chips {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
}

.meta-chip {
  display: inline-flex;
  align-items: center;

  padding: 3px 8px;

  background: var(--primary-light);
  color: var(--primary);

  border-radius: 999px;

  font-size: 0.65rem;
  font-weight: 700;
}

.subject-count {
  margin-left: auto;

  color: var(--text-muted);

  font-size: 0.68rem;

  white-space: nowrap;
}

/* =========================================================
   Chapter Cards
   ========================================================= */

.chapter-card {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  padding: 14px 16px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);

  box-shadow: var(--shadow-sm);

  cursor: pointer;
}

.chapter-number {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  background: var(--primary-light);
  color: var(--primary);

  border-radius: 50%;

  font-size: 0.8rem;
  font-weight: 700;
}

.chapter-info {
  flex: 1;
  min-width: 0;
}

.chapter-info h3 {
  font-size: 0.95rem;
  font-weight: 600;
}

.chapter-info span {
  color: var(--text-muted);
  font-size: 0.75rem;
}

.chapter-arrow {
  color: var(--text-muted);
}

/* =========================================================
   Note Cards
   ========================================================= */

.note-item-card,
.search-result-card {
  padding: 14px 16px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);

  box-shadow: var(--shadow-sm);

  cursor: pointer;
}

.note-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 6px;
}

.note-item-title {
  font-size: 1rem;
  font-weight: 700;
}

.note-peek-text {
  display: -webkit-box;

  color: var(--text-muted);

  font-size: 0.85rem;
  line-height: 1.4;

  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;

  overflow: hidden;
}

.note-meta-badges {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}

.meta-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;

  padding: 3px 8px;

  background: var(--primary-light);
  color: var(--primary);

  border-radius: 4px;

  font-size: 0.7rem;
  font-weight: 600;
}

/* =========================================================
   Library Toolbar
   ========================================================= */

.library-shell {
  display: flex;
  flex-direction: column;
  gap: 14px;

  overflow: visible;
}

/* =========================================================
   Library Tabs — Single Line
   ========================================================= */

.library-tabs {
  position: relative;
  
  display: flex;
  align-items: stretch;
  flex-wrap: nowrap;
  gap: 6px;
  
  width: 100%;
  min-width: 0;
  
  padding: 2px 0 8px;
  
  border-bottom: 1px solid var(--border);
  
  overflow: visible;
}

.library-tab {
  flex: 0 1 auto;
  min-width: 0;
  
  padding: 9px 12px;
  
  background: transparent;
  color: var(--text-muted);
  
  border: 0;
  border-radius: 9px;
  
  font-size: 0.78rem;
  font-weight: 700;
  line-height: 1.3;
  
  /* Keep tabs on one horizontal row,
     but allow text inside each tab to wrap vertically. */
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: normal;
  word-break: normal;
  
  cursor: pointer;
}

.library-tab.active {
  background: var(--primary-light);
  color: var(--primary);
}

.library-sync-btn {
  flex: 0 0 auto;
  margin-left: 0;
  
  display: inline-flex;
  align-items: center;
  gap: 5px;
  
  padding: 8px 10px;
  
  white-space: nowrap;
  
  background: var(--card-bg);
  color: var(--text-main);
  
  border: 1px solid var(--border);
  border-radius: 9px;
  
  font-size: 0.72rem;
  font-weight: 700;
  
  cursor: pointer;
}

.group-control {
  position: relative;
  z-index: 21;
  
  display: flex;
  align-items: stretch;
  
  flex: 0 0 auto;
  min-width: 0;
  
  margin-left: auto;
}

.library-group-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  
  flex: 0 0 auto;
  
  padding: 8px 10px;
  
  white-space: nowrap;
  
  background: var(--card-bg);
  color: var(--text-main);
  
  border: 1px solid var(--border);
  border-radius: 9px;
  
  font-size: 0.72rem;
  font-weight: 700;
  
  cursor: pointer;
}

.library-group-btn:hover {
  background: var(--primary-light);
  color: var(--primary);
}

.group-chevron {
  font-size: 17px !important;
  transition: transform 0.18s ease;
}

.group-control:has(.group-menu-inline.open) .group-chevron {
  transform: rotate(180deg);
}

/* Group dropdown */
.library-tabs .group-control .group-menu-inline {
  width: min(210px, calc(100vw - 24px)) !important;
  min-width: 0 !important;
  z-index: 1000;
}

/* =========================================================
   Group Dropdown
   ========================================================= */

.group-menu-inline {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  left: auto;
  z-index: 5000;

  display: none;

  width: 210px;
  min-width: 210px;
  max-width: calc(100vw - 24px);

  margin: 0;
}

.group-menu-inline.open {
  display: block;
}

.group-menu-panel {
  width: 100%;
  padding: 8px;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 14px;

  box-shadow: 0 18px 48px rgba(15, 23, 42, 0.14);

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.group-menu-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;

  padding: 9px 9px 10px;
}

.group-menu-head > div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.group-menu-head strong {
  font-size: 0.78rem;
}

.group-menu-head span:not(.material-symbols-outlined) {
  color: var(--text-muted);

  font-size: 0.64rem;
  line-height: 1.35;
}

.group-menu-head > .material-symbols-outlined {
  padding: 6px;

  background: var(--primary-light);
  color: var(--primary);

  border-radius: 10px;

  font-size: 20px;
}

.group-menu-options {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.group-menu-option,
.group-menu-actions button {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 10px 9px;

  background: transparent;
  color: var(--text-main);

  border: 0;
  border-radius: 11px;

  text-align: left;
  font-size: 0.74rem;

  cursor: pointer;
}

.group-menu-option:hover,
.group-menu-actions button:hover,
.group-menu-option.selected {
  background: var(--primary-light);
  color: var(--primary);
}

.group-menu-option > .material-symbols-outlined {
  color: var(--text-muted);
  font-size: 18px;
}

.group-menu-option.selected > .material-symbols-outlined:first-child {
  color: var(--primary);
}

.group-menu-option .group-check {
  margin-left: auto;

  color: var(--primary);
  font-size: 18px;
}

.group-menu-actions {
  margin-top: 6px;
  padding-top: 6px;

  border-top: 1px solid var(--border);
}

.group-menu-actions button .material-symbols-outlined {
  color: var(--text-muted);
  font-size: 17px;
}

.library-toolbar-note {
  display: flex;
  align-items: center;
  gap: 8px;

  padding: 9px 11px;

  background: var(--primary-light);
  color: var(--text-muted);

  border: 1px solid var(--border);
  border-radius: 10px;

  font-size: 0.7rem;
  line-height: 1.4;
}

.library-toolbar-note .material-symbols-outlined {
  color: var(--primary);
  font-size: 18px;
}

/* =========================================================
   Reader
   ========================================================= */

.reader-card {
  padding: 18px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: var(--radius-lg);

  box-shadow: var(--shadow-sm);
}

.reader-header {
  margin-bottom: 14px;
}

.reader-tags {
  display: flex;
  gap: 6px;
  margin-bottom: 8px;
}

.tag-badge {
  padding: 3px 8px;

  border-radius: 6px;

  font-size: 0.7rem;
  font-weight: 600;
}

.tag-badge.subject {
  background: var(--primary-light);
  color: var(--primary);
}

.tag-badge.chapter {
  background: #fef3c7;
  color: #92400e;
}

[data-theme="dark"] .tag-badge.chapter {
  background: #3a2e15;
  color: #fde68a;
}

.tag-badge.label,
.label-badge {
  background: var(--bg-color);
  color: var(--text-muted);

  border: 1px solid var(--border);
}

.reader-title {
  margin-bottom: 12px;

  font-size: 1.35rem;
  font-weight: 700;
}

.reader-body {
  margin-bottom: 20px;

  color: var(--text-main);

  font-size: 0.95rem;
  line-height: 1.75;

  word-break: break-word;
}

.reader-body p {
  margin-bottom: 12px;
}

.reader-body ul,
.reader-body ol {
  margin: 10px 0 14px 20px;
}

.reader-body li {
  margin-bottom: 6px;
}

.reader-body h3,
.reader-body h4 {
  margin: 18px 0 8px;

  color: var(--primary);

  font-size: 1.08rem;
  font-weight: 700;
}

.reader-body blockquote {
  margin: 14px 0;
  padding: 10px 14px;

  background: var(--primary-light);

  border-left: 4px solid var(--primary);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;

  font-style: italic;
}

.reader-body table {
  display: block;

  width: 100%;
  margin: 16px 0;

  font-size: 0.88rem;

  border-collapse: collapse;

  overflow-x: auto;
}

.reader-body th,
.reader-body td {
  padding: 8px 12px;

  border: 1px solid var(--border);

  text-align: left;
}

.reader-body th {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 700;
}

.reader-body code {
  padding: 2px 6px;

  background: var(--bg-color);

  border: 1px solid var(--border);
  border-radius: 4px;

  font-family: monospace;
  font-size: 0.85em;
}

.reader-body hr {
  margin: 20px 0;

  border: 0;
  border-top: 1px dashed var(--border);
}

mark.term {
  padding: 1px 4px;

  background: var(--term-bg);
  color: var(--term-text);

  border-bottom: 2px dashed var(--term-border);
  border-radius: 4px;

  font-weight: 600;

  cursor: pointer;
}

.danger-action {
  color: var(--danger-text) !important;
}

/* =========================================================
   Q&A / MCQ
   ========================================================= */

.qa-card {
  margin: 10px 0;
  padding: 10px 14px;

  background: var(--bg-color);

  border-left: 3px solid var(--primary);
  border-radius: 6px;
}

.qa-question {
  display: flex;
  justify-content: space-between;

  font-size: 0.92rem;
  font-weight: 600;

  cursor: pointer;
}

.qa-answer {
  margin-top: 8px;
  padding-top: 8px;

  color: var(--text-muted);

  border-top: 1px dashed var(--border);

  font-size: 0.88rem;
}

.hidden-answer {
  display: none !important;
}

.qa-chevron {
  transition: transform 0.16s ease;
}

.qa-question.open .qa-chevron {
  transform: rotate(180deg);
}

.mcq-card {
  margin: 10px 0;
  padding: 12px;

  background: var(--bg-color);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.mcq-question {
  margin-bottom: 10px;

  font-size: 0.92rem;
  font-weight: 600;
}

.mcq-options {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.mcq-opt {
  padding: 10px 12px;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 6px;

  text-align: left;
  font-size: 0.88rem;

  cursor: pointer;
}

.mcq-opt.correct {
  background: var(--success-bg) !important;
  color: var(--success-text) !important;

  border-color: var(--success-text) !important;

  font-weight: 600;
}

.mcq-opt.incorrect {
  background: var(--danger-bg) !important;
  color: var(--danger-text) !important;

  border-color: var(--danger-text) !important;
}

.reader-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;

  margin-top: 20px;
  padding-top: 12px;

  border-top: 1px solid var(--border);
}

/* =========================================================
   Context Gathering
   ========================================================= */

.context-gathering .reader-body,
.context-gathering .qa-card,
.context-gathering .mcq-card {
  cursor: pointer;
}

.context-gathering .context-selectable {
  outline: 2px dashed var(--primary);
  outline-offset: 3px;

  border-radius: 6px;

  transition:
    background 0.15s ease,
    outline-color 0.15s ease,
    box-shadow 0.15s ease;
}

.context-gathering
  .context-selectable[data-context-type="paragraph"] {
  display: block;
  position: relative;

  margin: 12px 0px;
  padding: 4px 6px;
}

.context-gathering .context-selectable:hover {
  background: var(--primary-light);
}

.context-gathering .context-selectable.omni-selected {
  background: var(--primary-light) !important;

  outline: 2px solid var(--primary) !important;
  outline-offset: 3px !important;

  box-shadow:
    0 0 0 3px
    color-mix(in srgb, var(--primary) 12%, transparent) !important;
}

/* =========================================================
   Modals / Forms
   ========================================================= */

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;

  display: flex;
  align-items: flex-end;
  justify-content: center;

  background: rgba(15, 23, 42, 0.6);

  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}

.modal-sheet {
  width: 100%;
  max-width: 520px;
  max-height: 90vh;

  padding: 20px;

  overflow-y: auto;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 20px 20px 0 0;

  box-shadow: 0 28px 80px rgba(15, 23, 42, 0.2);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 14px;
}

.modal-title-wrap {
  display: flex;
  align-items: center;
  gap: 8px;

  min-width: 0;
}

.modal-icon-wrap {
  width: 36px;
  height: 36px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  background: var(--primary-light);
  color: var(--primary);

  border-radius: 12px;
}

.modal-icon-wrap .material-symbols-outlined {
  font-size: 19px;
}

.modal-kicker {
  display: block;

  margin-bottom: 2px;

  color: var(--primary);

  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.modal-title-wrap h2 {
  font-size: 1.08rem;
}

.modal-desc {
  margin-bottom: 16px;

  color: var(--text-muted);

  font-size: 0.88rem;
  line-height: 1.5;
}

.close-btn {
  background: none;
  color: var(--text-muted);

  border: none;

  cursor: pointer;
}

.form-field label {
  display: flex;
  align-items: center;
  gap: 5px;

  margin-top: 0;
}

.optional-label {
  color: var(--text-muted);

  font-size: 0.62rem;
  font-weight: 500;
}

form label {
  display: block;

  margin-top: 10px;

  color: var(--text-muted);

  font-size: 0.8rem;
  font-weight: 600;
}

.form-field input,
.form-field textarea,
.form-field select,
form input,
form textarea,
form select {
  width: 100%;
  min-height: 42px;

  margin-top: 4px;
  padding: 10px 12px;

  background: var(--bg-color);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 12px;

  outline: none;

  font-size: 0.9rem;

  transition:
    border-color 0.16s ease,
    box-shadow 0.16s ease,
    background 0.16s ease;
}

.form-field textarea,
form textarea {
  min-height: 96px;
}

.form-field input:focus,
.form-field textarea:focus,
.form-field select:focus,
form input:focus,
form textarea:focus,
form select:focus {
  border-color: color-mix(
    in srgb,
    var(--primary) 65%,
    var(--border)
  );

  box-shadow:
    0 0 0 3px
    color-mix(in srgb, var(--primary) 12%, transparent);
}

.form-row {
  display: flex;
  gap: 10px;
}

.form-field {
  flex: 1;
}

/* =========================================================
   Buttons
   ========================================================= */

.btn-primary,
.btn-secondary,
.btn-ghost,
.file-upload-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  padding: 10px 14px;

  border-radius: var(--radius-md);

  font-size: 0.88rem;
  font-weight: 600;

  border: none;
  cursor: pointer;
}

.btn-primary {
  flex: 2;

  background: var(--primary);
  color: #ffffff;
}

.btn-primary:hover {
  background: var(--primary-hover);
}

.btn-secondary {
  background: var(--primary-light);
  color: var(--primary);

  border: 1px solid var(--border);
}

.btn-ghost {
  background: var(--bg-color);
  color: var(--text-main);

  border: 1px solid var(--border);
}

.btn-sm {
  max-width: max-content;

  padding: 6px 10px;

  font-size: 0.76rem;
}

.btn-danger-soft {
  padding: 6px 9px;

  background: color-mix(
    in srgb,
    var(--danger-text) 8%,
    transparent
  );
  color: var(--danger-text);

  border: 1px solid
    color-mix(
      in srgb,
      var(--danger-text) 25%,
      var(--border)
    );

  border-radius: 9px;

  font-size: 0.7rem;
  font-weight: 700;

  cursor: pointer;
}

.form-actions,
.backup-actions,
.merge-actions {
  display: flex;
  gap: 10px;

  margin-top: 16px;
}

.backup-actions,
.merge-actions {
  flex-direction: column;
}

/* =========================================================
   Tabs / AI
   ========================================================= */

.tab-switcher {
  display: flex;
  gap: 4px;

  margin-bottom: 14px;
  padding: 4px;

  background: var(--bg-color);

  border-radius: var(--radius-md);
}

.tab-btn {
  flex: 1;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  padding: 8px 12px;

  background: transparent;
  color: var(--text-muted);

  border: none;
  border-radius: 6px;

  font-size: 0.82rem;
  font-weight: 600;

  cursor: pointer;
}

.tab-btn.active {
  background: var(--card-bg);
  color: var(--primary);

  box-shadow: var(--shadow-sm);
}

#ai-json-input {
  font-family: monospace;
  font-size: 0.82rem;
}

.ai-box {
  margin-bottom: 12px;
  padding: 12px;

  background: var(--primary-light);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.ai-box-header {
  margin-bottom: 8px;
}

.ai-title {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  color: var(--primary);

  font-size: 0.85rem;
  font-weight: 700;
}

.ai-btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.ai-hint {
  margin-top: 8px;

  color: var(--text-muted);

  font-size: 0.76rem;
  line-height: 1.4;
}

.term-helper-wrap {
  margin-top: 6px;
}

/* =========================================================
   Term Sheet
   ========================================================= */

.term-sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  margin-bottom: 12px;
}

.term-pill {
  padding: 2px 8px;

  background: var(--term-bg);
  color: var(--term-text);

  border-radius: 4px;

  font-size: 0.7rem;
  font-weight: 700;
}

#term-title {
  margin-top: 4px;
  font-size: 1.25rem;
}

.context-block {
  margin-bottom: 12px;
}

.context-block label {
  color: var(--text-muted);

  font-size: 0.72rem;
  font-weight: 700;

  text-transform: uppercase;
}

.context-block p {
  margin-top: 4px;

  font-size: 0.92rem;
  line-height: 1.45;
}

/* =========================================================
   Patch Context
   ========================================================= */

.patch-context-box {
  display: flex;
  align-items: flex-start;
  gap: 8px;

  margin: 12px 0;
  padding: 10px;

  background: var(--primary-light);

  border: 1px solid var(--border);
  border-radius: 10px;
}

.patch-context-box .material-symbols-outlined {
  color: var(--primary);
  font-size: 20px;
}

.patch-context-box strong {
  font-size: 0.8rem;
}

.patch-context-box p {
  margin: 2px 0 0;

  color: var(--text-muted);

  font-size: 0.72rem;
  line-height: 1.4;
}

#patch-note-select,
#patch-target-select {
  width: 100%;

  margin-top: 4px;
  padding: 10px 12px;

  background: var(--bg-color);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);

  font-size: 0.85rem;
}

#patch-json-input {
  display: block;

  width: 100%;
  min-height: 190px;

  box-sizing: border-box;

  margin-top: 7px;
  padding: 12px 13px;

  background: var(--bg-color);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);

  outline: none;
  resize: vertical;

  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.04);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    "Liberation Mono",
    monospace !important;

  font-size: 0.78rem !important;
  line-height: 1.6 !important;
  letter-spacing: 0;

  white-space: pre;
  tab-size: 2;

  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease,
    background 0.15s ease;
}

#patch-json-input::placeholder {
  color: var(--text-muted);
  opacity: 0.75;
}

#patch-json-input:focus {
  background: var(--card-bg);
  border-color: var(--primary);

  box-shadow:
    0 0 0 3px var(--primary-light);
}

/* =========================================================
   Asset Workspace
   ========================================================= */

.asset-workspace {
  max-width: 640px;
  padding: 20px;
}

.asset-target-card {
  display: flex;
  align-items: flex-start;
  gap: 10px;

  margin-bottom: 12px;
  padding: 12px 13px;

  background: var(--primary-light);

  border: 1px solid
    color-mix(in srgb, var(--primary) 22%, var(--border));
  border-radius: 15px;
}

.asset-target-card > .material-symbols-outlined {
  margin-top: 1px;

  color: var(--primary);
  font-size: 21px;
}

.asset-target-card > div {
  display: flex;
  flex-direction: column;
  gap: 3px;

  min-width: 0;
}

.asset-target-card strong {
  font-size: 0.76rem;
  line-height: 1.35;
}

.asset-target-card span:not(.material-symbols-outlined) {
  color: var(--text-muted);
  font-size: 0.65rem;
}

.asset-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.asset-section-card {
  display: flex;
  flex-direction: column;
  gap: 11px;

  padding: 13px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: 16px;
}

.asset-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;

  padding-bottom: 2px;
}

.asset-section-heading div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.asset-section-heading strong {
  font-size: 0.76rem;
}

.asset-section-heading span {
  color: var(--text-muted);

  font-size: 0.64rem;
  line-height: 1.35;
}

.asset-form-row {
  margin-top: 2px;
}

.asset-form-row .form-field {
  min-width: 0;
}

.asset-form .form-field {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.asset-form .form-field input,
.asset-form .form-field textarea,
.asset-form .form-field select {
  width: 100%;
  margin-top: 0;
}

.asset-form-tip {
  display: flex;
  align-items: flex-start;
  gap: 8px;

  padding: 10px 11px;

  color: var(--text-muted);

  border: 1px dashed var(--border);
  border-radius: 13px;

  font-size: 0.65rem;
  line-height: 1.4;
}

.asset-form-tip .material-symbols-outlined {
  color: var(--primary);
  font-size: 17px;
}

.asset-form-actions {
  justify-content: flex-end;
}

.asset-form-actions .btn-secondary {
  flex: 0 0 auto;
}

.asset-form-actions .btn-primary {
  flex: 0 0 auto;
  min-width: 150px;
}

/* =========================================================
   Custom Groups
   ========================================================= */

.custom-group-sheet {
  max-width: 680px;
}

.custom-group-body {
  display: flex;
  flex-direction: column;
  gap: 10px;

  max-height: 52vh;

  overflow: auto;
  padding: 2px;
}

.custom-group-drop {
  padding: 9px;

  background: var(--bg-color);

  border: 1px dashed var(--border);
  border-radius: 12px;

  transition: 0.12s;
}

.custom-group-drop.drag-over {
  background: var(--primary-light);
  border-color: var(--primary);
}

.custom-group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 7px;

  font-size: 0.75rem;
}

.custom-group-delete {
  background: transparent;
  color: var(--danger-text);

  border: 0;

  font-size: 16px;

  cursor: pointer;
}

.custom-group-subjects {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;

  min-height: 38px;
}

.custom-group-subject {
  display: inline-flex;
  align-items: center;
  gap: 4px;

  padding: 7px 9px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: 9px;

  font-size: 0.7rem;

  cursor: grab;
  touch-action: none;
  user-select: none;
}

.custom-group-subject .material-symbols-outlined {
  color: var(--text-muted);
  font-size: 16px;
}

.custom-group-empty {
  padding: 7px;

  color: var(--text-muted);

  font-size: 0.68rem;
}

.custom-group-dragging {
  user-select: none;
}

/* =========================================================
   Study Profile
   ========================================================= */

.study-profile-sheet {
  max-width: 680px;
}

.study-profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 11px;

  margin-top: 12px;
}

.study-profile-wide {
  grid-column: 1 / -1;
}

.study-profile-grid input {
  width: 100%;
  box-sizing: border-box;

  margin-top: 5px;
  padding: 11px 12px;

  background: var(--bg-color);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 12px;

  outline: none;

  font: inherit;
  font-size: 0.82rem;
}

.study-profile-grid input:focus {
  border-color: var(--primary);

  box-shadow:
    0 0 0 3px var(--primary-light);
}

.study-profile-note {
  display: flex;
  align-items: flex-start;
  gap: 8px;

  margin-top: 14px;
  padding: 10px 12px;

  background: var(--primary-light);
  color: var(--text-muted);

  border: 1px solid var(--border);
  border-radius: 12px;

  font-size: 0.7rem;
  line-height: 1.45;
}

.study-profile-note .material-symbols-outlined {
  flex: 0 0 auto;

  color: var(--primary);
  font-size: 18px;
}

.study-profile-actions {
  justify-content: flex-end;
}

/* =========================================================
   Library Transfer
   ========================================================= */

.library-transfer-sheet {
  max-width: 700px;
  padding: 20px;
}

.transfer-intro {
  display: flex;
  flex-direction: column;
  gap: 10px;

  margin-bottom: 4px;
}

.transfer-intro > p {
  color: var(--text-muted);

  font-size: 0.74rem;
  line-height: 1.5;
}

.transfer-safety {
  display: flex;
  align-items: flex-start;
  gap: 8px;

  padding: 10px 11px;

  background: var(--primary-light);
  color: var(--text-muted);

  border-radius: 13px;

  font-size: 0.65rem;
  line-height: 1.4;
}

.transfer-safety .material-symbols-outlined {
  color: var(--primary);
  font-size: 18px;
}

.transfer-safety strong {
  margin-right: 3px;
  color: var(--text-main);
}

.transfer-section {
  padding: 15px 0 2px;
}

.transfer-section + .transfer-section {
  margin-top: 6px;
  border-top: 1px solid var(--border);
}

.transfer-section-head > div {
  display: flex;
  align-items: flex-start;
  gap: 9px;

  margin-bottom: 10px;
}

.transfer-step {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  background: var(--primary-light);
  color: var(--primary);

  border-radius: 9px;

  font-size: 0.62rem;
  font-weight: 800;
}

.transfer-section-head h3 {
  margin-bottom: 2px;
  font-size: 0.78rem;
}

.transfer-section-head p {
  color: var(--text-muted);

  font-size: 0.64rem;
  line-height: 1.4;
}

.transfer-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.transfer-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 5px;

  min-width: 0;
  min-height: 112px;

  padding: 13px;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 15px;

  text-align: left;

  cursor: pointer;

  transition:
    transform 0.16s ease,
    border-color 0.16s ease,
    background 0.16s ease,
    box-shadow 0.16s ease;
}

.transfer-card:hover {
  background: var(--primary-light);

  border-color:
    color-mix(in srgb, var(--primary) 45%, var(--border));

  box-shadow: var(--shadow-sm);

  transform: translateY(-1px);
}

.transfer-card > .material-symbols-outlined {
  margin-bottom: 2px;

  color: var(--primary);
  font-size: 21px;
}

.transfer-card strong {
  font-size: 0.76rem;
}

.transfer-card small {
  color: var(--text-muted);

  font-size: 0.65rem;
  line-height: 1.4;
}

.transfer-card-feature {
  border-color:
    color-mix(in srgb, var(--primary) 35%, var(--border));
}

.transfer-more {
  margin-top: 14px;
  padding-top: 11px;

  border-top: 1px solid var(--border);
}

.transfer-more summary {
  display: flex;
  align-items: center;
  justify-content: space-between;

  color: var(--text-muted);

  font-size: 0.7rem;
  font-weight: 700;

  cursor: pointer;
  list-style: none;
}

.transfer-more summary::-webkit-details-marker {
  display: none;
}

.transfer-more summary .material-symbols-outlined {
  font-size: 18px;

  transition: transform 0.16s ease;
}

.transfer-more[open]
  summary
  .material-symbols-outlined {
  transform: rotate(180deg);
}

.advanced-transfer {
  display: flex;
  flex-direction: column;
  gap: 9px;

  padding-top: 10px;
}

.advanced-transfer .btn-secondary {
  justify-content: flex-start;
}

.patch-export-box {
  padding: 11px;

  background: var(--bg-color);

  border: 1px solid var(--border);
  border-radius: 14px;
}

.patch-export-box strong {
  font-size: 0.85rem;
}

.patch-export-box p {
  margin: 5px 0 10px;

  color: var(--text-muted);

  font-size: 0.7rem;
  line-height: 1.4;
}

.patch-export-row {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.patch-export-row select {
  flex: 1;
  min-width: 130px;

  padding: 9px;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);

  outline: none;

  font-size: 0.7rem;
}

/* =========================================================
   History
   ========================================================= */

.history-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.history-item {
  padding: 10px;

  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.history-main {
  display: flex;
  flex-direction: column;
  gap: 3px;

  min-width: 0;
}

.history-main strong {
  font-size: 0.72rem;
  overflow-wrap: anywhere;
}

.history-main time,
.history-main > span:last-child {
  color: var(--text-muted);
  font-size: 0.7rem;
}

.history-kind {
  color: var(--primary);

  font-size: 0.68rem;
  font-weight: 700;

  text-transform: uppercase;
}

.history-actions {
  display: flex;
  justify-content: flex-end;

  margin-top: 8px;
}

.history-current {
  color: var(--success-text);

  font-size: 0.72rem;
  font-weight: 700;
}

/* =========================================================
   Omnibox
   ========================================================= */

.omni-box {
  position: fixed;
  left: 50%;
  bottom: calc(
    18px + var(--studiora-keyboard-offset, 0px)
  );
  z-index: 75;

  display: flex;
  flex-direction: column;

  width: min(900px, calc(100vw - 24px));

  padding: 9px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: 18px;

  box-shadow: var(--shadow-md);

  transform: translateX(-50%);

  transition:
    transform 0.2s ease,
    opacity 0.2s ease,
    box-shadow 0.2s ease;
}

.omni-box.omni-hidden-scroll {
  opacity: 0.2;
  pointer-events: none;

  transform:
    translate(
      -50%,
      calc(100% + 24px)
    );
}

.omni-box.omni-gathering {
  bottom: 14px;
}

.omni-box.omni-gathering .omni-compose {
  opacity: 0.45;
  pointer-events: none;
}

body.omni-gathering-active {
  padding-bottom: 140px;
}

/* Context */

.omni-context-thread {
  position: relative;
  z-index: 1000;
  order: 0;

  margin-bottom: 8px;

  background: var(--bg-color);

  border: 1px solid var(--border);
  border-radius: 13px;

  box-shadow: var(--shadow-md);

  overflow: hidden;
}

.omni-context-head {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 8px 10px;

  border-bottom: 1px solid var(--border);
}

.omni-context-head strong {
  display: block;
  font-size: 0.75rem;
}

.omni-context-head span {
  display: block;

  margin-top: 2px;

  color: var(--text-muted);

  font-size: 0.65rem;
}

.omni-context-head-actions {
  display: flex;
  align-items: center;
  gap: 5px;
}

.omni-context-close {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: transparent;
  color: var(--text-muted);

  border: 0;
  border-radius: 50%;

  cursor: pointer;
}

.omni-context-close:hover {
  background: var(--primary-light);
  color: var(--primary);
}

.omni-context-list {
  display: flex;
  gap: 6px;

  overflow-x: auto;
  padding: 7px;
}

.omni-context-chip {
  flex: 0 0 auto;

  padding: 7px 9px;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 9px;

  text-align: left;
  font-size: 0.68rem;

  white-space: nowrap;

  cursor: pointer;
}

.omni-context-chip.selected {
  background: var(--primary-light);
  color: var(--primary);

  border-color: var(--primary);
}

.omni-context-done {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  background: var(--primary);
  color: #ffffff;

  border: 0;
  border-radius: 50%;

  cursor: pointer;
}

/* Compose */

.omni-compose {
  order: 1;

  display: flex;
  align-items: flex-end;
  gap: 7px;
}

.omni-compose textarea {
  flex: 1;

  min-height: 54px;
  max-height: 150px;

  padding: 12px;

  background: var(--bg-color);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 12px;

  outline: none;
  resize: none;

  font: inherit;
  font-size: 0.82rem;
  line-height: 1.4;
}

.omni-compose textarea:focus {
  border-color: var(--primary);

  box-shadow:
    0 0 0 3px var(--primary-light);
}

.omni-submit {
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  background: var(--primary);
  color: #ffffff;

  border: 0;
  border-radius: 50%;

  cursor: pointer;
}

.omni-submit:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* =========================================================
   Omnibox Modes — Single Line
   ========================================================= */

.omni-modes {
  order: 2;
  
  display: flex;
  align-items: center;
  justify-content: space-between;
  
  width: 100%;
  min-width: 0;
  
  margin-top: 7px;
  margin-bottom: 0;
  
  overflow: hidden;
  
  scrollbar-width: none;
}

.omni-modes::-webkit-scrollbar {
  display: none;
}

.omni-mode {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  
  flex: 0 0 auto;
  min-width: 0;
  
  padding: 6px 9px;
  
  background: transparent;
  color: var(--text-muted);
  
  border: 1px solid transparent;
  border-radius: 999px;
  
  font-size: 0.7rem;
  font-weight: 700;
  
  white-space: nowrap;
  
  cursor: pointer;
}

.omni-mode.active {
  background: var(--primary-light);
  color: var(--primary);
  
  border-color: var(--border);
}

.omni-mode .material-symbols-outlined {
  flex: 0 0 auto;
  font-size: 16px;
}

.omni-mode.hidden {
  display: none;
}

.omni-mode[data-omni-mode="manual"] {
  background: var(--card-bg);
  color: var(--text-main);
  
  border-color: var(--border);
}

.omni-mode[data-omni-mode="manual"]:hover,
.omni-mode[data-omni-mode="manual"].active {
  background: var(--primary-light);
  color: var(--primary);
  
  border-color: var(--primary);
}

/* Response */

.omni-response-wrap {
  order: 3;

  margin-top: 8px;
  padding-top: 8px;

  border-top: 1px solid var(--border);
}

.omni-response-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;

  margin-bottom: 6px;
}

.omni-response-head strong {
  font-size: 0.75rem;
}

.omni-response-head span {
  color: var(--text-muted);
  font-size: 0.65rem;
}

#omni-response-input {
  width: 100%;
  min-height: 130px;

  box-sizing: border-box;

  margin-bottom: 7px;
  padding: 10px;

  background: var(--bg-color);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 10px;

  outline: none;
  resize: vertical;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size: 0.75rem;
}

.omni-response-wrap .btn-primary {
  min-width: 140px;
}

/* Clipboard */

.omni-clipboard-prompt {
  position: fixed;
  inset: 0;
  z-index: 10050;

  display: flex;
  align-items: flex-end;
  justify-content: center;

  padding: 18px;

  pointer-events: none;
}

.omni-clipboard-card {
  width: min(440px, 100%);

  display: grid;
  grid-template-columns: auto 1fr;
  gap: 10px;

  padding: 16px;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 20px;

  box-shadow: var(--shadow-md);

  pointer-events: auto;
}

.omni-clipboard-icon {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  background: var(--primary-light);
  color: var(--primary);

  border-radius: 12px;
}

.omni-clipboard-copy strong {
  font-size: 0.88rem;
}

.omni-clipboard-copy p {
  margin: 3px 0 0;

  color: var(--text-muted);

  font-size: 0.72rem;
  line-height: 1.45;
}

.omni-clipboard-actions {
  grid-column: 1 / -1;

  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8px;
}

.omni-clipboard-actions button {
  padding: 8px 12px;

  border-radius: 12px;
}

/* =========================================================
   Manual Workspace
   ========================================================= */

.manual-workspace {
  position: fixed;
  inset: 0;
  z-index: 12000;

  display: flex;
  align-items: flex-end;
  justify-content: center;

  background: rgba(15, 23, 42, 0.62);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.manual-workspace-sheet {
  width: min(760px, 100%);
  max-height: 94vh;

  padding: 20px;

  overflow: auto;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 24px 24px 0 0;

  box-shadow: 0 28px 80px rgba(0, 0, 0, 0.28);
}

.manual-workspace-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;

  margin-bottom: 18px;
}

.manual-eyebrow {
  color: var(--primary);

  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.manual-workspace-header h2 {
  margin: 4px 0 3px;
  font-size: 1.25rem;
}

.manual-workspace-header p,
.manual-hero p,
.manual-focus-banner p,
.manual-add-panel p {
  margin: 0;

  color: var(--text-muted);

  font-size: 0.76rem;
  line-height: 1.5;
}

.manual-workspace-content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.manual-hero,
.manual-focus-banner {
  display: flex;
  gap: 12px;

  padding: 13px;

  background: var(--primary-light);

  border: 1px solid var(--border);
  border-radius: 16px;
}

.manual-hero > .material-symbols-outlined,
.manual-focus-banner > .material-symbols-outlined {
  color: var(--primary);
  font-size: 25px;
}

.manual-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.manual-label {
  display: block;

  color: var(--text-muted);

  font-size: 0.73rem;
  font-weight: 700;
}

.manual-label input,
.manual-workspace-content input,
.manual-workspace-content textarea,
.manual-workspace-content select {
  width: 100%;

  margin-top: 5px;
  padding: 11px 12px;

  background: var(--bg-color);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 12px;

  outline: none;

  font: inherit;
  font-size: 0.82rem;
}

.manual-editor-area {
  min-height: 150px;
  resize: vertical;
}

.manual-create-parts,
.manual-edit-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.manual-part-card,
.manual-edit-card,
.manual-add-panel {
  display: flex;
  flex-direction: column;
  gap: 8px;

  padding: 12px;

  background: var(--bg-color);

  border: 1px solid var(--border);
  border-radius: 16px;
}

.manual-part-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;

  font-size: 0.78rem;
}

.manual-add-row,
.manual-add-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.manual-add-row select {
  flex: 1;
  min-width: 180px;
}

.manual-workspace-json-row {
  display: flex;
  flex-direction: column;
  gap: 8px;

  margin-top: 16px;
}

.manual-json-box {
  width: 100%;

  padding: 12px;

  background: var(--bg-color);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 14px;

  resize: vertical;

  font-family:
    ui-monospace,
    SFMono-Regular,
    monospace;

  font-size: 0.78rem;
}

.manual-workspace-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  margin-top: 16px;
  padding-top: 13px;

  border-top: 1px solid var(--border);
}

.manual-workspace-footer > span {
  display: flex;
  align-items: center;
  gap: 6px;

  color: var(--text-muted);

  font-size: 0.67rem;
}

.manual-workspace-footer .material-symbols-outlined {
  color: var(--primary);
  font-size: 17px;
}

/* =========================================================
   Visual Assets
   ========================================================= */

.note-asset {
  overflow: hidden;

  margin: 12px 0;
  padding: 10px;

  background: var(--bg-color);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.note-asset img {
  display: block;

  width: 100%;
  max-width: 100%;
  max-height: 420px;
  height: auto;

  object-fit: contain;

  background: var(--card-bg);

  border-radius: 7px;
}

.note-asset figcaption {
  margin-top: 7px;

  color: var(--text-muted);

  font-size: 0.75rem;
  line-height: 1.4;
}

.asset-source {
  display: inline-block;

  margin-top: 6px;

  color: var(--primary);

  font-size: 0.7rem;
  text-decoration: none;
}

.asset-placeholder {
  min-height: 70px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  padding: 18px;

  color: var(--text-muted);

  border: 1px dashed var(--border);
  border-radius: 8px;

  font-size: 0.8rem;
}

.visual-svg-wrap {
  width: 100%;
  max-width: 100%;

  overflow: auto;

  padding: 8px;

  background: var(--bg-color);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.note-diagram,
.note-graph {
  display: block;

  width: 100%;
  min-width: 360px;
  height: auto;

  color: var(--text-main);
}

.qa-answer .note-asset,
.qa-question + .note-asset,
.mcq-question + .note-asset {
  margin-right: 0;
  margin-left: 0;
}

/* =========================================================
   Toasts
   ========================================================= */

.toast {
  position: fixed;
  left: 50%;
  bottom: 22px;
  z-index: 99999;

  display: flex;
  align-items: center;
  gap: 9px;

  max-width: min(92vw, 560px);

  padding: 11px 15px;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: 14px;

  box-shadow: var(--shadow-md);

  text-align: left;

  font-size: 0.76rem;
  font-weight: 650;
  line-height: 1.35;

  opacity: 0;
  pointer-events: none;

  transform: translate(-50%, 16px) scale(0.98);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.toast.visible {
  opacity: 1;

  transform:
    translate(-50%, 0)
    scale(1);
}

.toast-icon {
  flex: 0 0 auto;

  color: var(--primary);
  font-size: 19px;
}

.toast-message {
  display: block;
}

/* =========================================================
   Search Results
   ========================================================= */

.search-summary {
  padding: 4px;

  color: var(--text-muted);

  font-size: 0.76rem;
}

.search-result-top {
  display: flex;
  align-items: center;
  gap: 8px;
}

.search-result-top strong {
  flex: 1;
  min-width: 0;

  overflow: hidden;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-score {
  color: var(--text-muted);
  font-size: 0.65rem;
}

.search-path {
  margin: 6px 0;

  color: var(--primary);

  font-size: 0.7rem;
}

.search-result-card p {
  margin: 0;

  color: var(--text-muted);

  font-size: 0.82rem;
  line-height: 1.45;
}

.search-matches {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;

  margin-top: 9px;
}

.search-empty-state {
  min-height: 45vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;

  color: var(--text-muted);

  text-align: center;
}

.search-empty-state .material-symbols-outlined {
  color: var(--primary);
  font-size: 42px;
}

.search-empty-state strong {
  color: var(--text-main);
}

/* =========================================================
   Empty / Coming Soon
   ========================================================= */

.coming-soon-card {
  min-height: 260px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 28px;

  background: var(--card-bg);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);

  box-shadow: var(--shadow-sm);

  text-align: center;
}

.coming-soon-card .material-symbols-outlined {
  margin-bottom: 8px;

  color: var(--primary);
  font-size: 48px;
}

.coming-soon-card h2 {
  margin: 0 0 5px;

  font-size: 1.15rem;
}

.coming-soon-card p {
  margin: 0 0 7px;

  color: var(--primary);

  font-weight: 800;
}

.coming-soon-card span:last-child {
  max-width: 420px;

  color: var(--text-muted);

  font-size: 0.78rem;
  line-height: 1.5;
}

.download-category {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.library-empty-card {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 16px;

  background: var(--card-bg);
  color: var(--text-muted);

  border: 1px dashed var(--border);
  border-radius: var(--radius-md);
}

.library-empty-card .material-symbols-outlined {
  color: var(--primary);
  font-size: 28px;
}

.library-empty-card strong {
  display: block;

  color: var(--text-main);

  font-size: 0.8rem;
}

.library-empty-card p {
  margin: 3px 0 0;

  font-size: 0.72rem;
  line-height: 1.4;
}

.noscript-content {
  max-width: 760px;

  margin: 40px auto;
  padding: 24px;

  background: var(--card-bg);
  color: var(--text-main);

  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.noscript-content h2 {
  margin-top: 0;
}

.noscript-content p {
  color: var(--text-muted);

  line-height: 1.6;
}

/* =========================================================
   Responsive: <= 700px
   ========================================================= */

@media (max-width: 700px) {
  .search-bar-wrap {
    top: 61px;
    padding: 8px 10px;
  }

  .search-popover {
    right: 10px;
  }

  .header-text h1 {
    max-width: 190px;
  }

  .asset-workspace,
  .library-transfer-sheet {
    max-width: 100%;

    padding: 16px;

    border-radius: 20px 20px 0 0;
  }

  .asset-form-row,
  .form-row {
    flex-direction: column;
  }

  .asset-form-actions {
    position: sticky;
    bottom: -16px;

    margin-top: 0;
    padding: 14px 0 16px;

    background:
      linear-gradient(
        to top,
        var(--card-bg) 70%,
        transparent
      );
  }

  .asset-form-actions .btn-secondary,
  .asset-form-actions .btn-primary {
    width: 100%;
    min-width: 0;
  }

  .transfer-grid {
    grid-template-columns: 1fr;
  }

  .transfer-card {
    min-height: 94px;
  }

  .library-transfer-sheet {
    max-height: 94vh;
  }

  .transfer-section {
    padding-top: 13px;
  }
}

/* =========================================================
   Responsive: <= 600px
   ========================================================= */

@media (max-width: 600px) {
  .header-action {
    padding: 7px 9px;
  }

  .header-action span:last-child {
    display: none;
  }

  .active-search-chips {
    padding: 0 2px;
  }

  .header-more-menu {
    right: 0;
    width: 180px;
  }

  .library-tab {
    padding: 8px 9px;
  }

  .library-sync-btn {
    margin-left: 0;
  }

  .library-group-btn {
    padding: 8px 9px;
  }

  .coming-soon-card {
    min-height: 220px;
  }

  .manual-grid {
    grid-template-columns: 1fr;
  }

  .transfer-grid {
    grid-template-columns: 1fr;
  }

  .manual-workspace-sheet {
    padding: 15px;

    border-radius: 20px 20px 0 0;
  }

  .manual-workspace-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .manual-workspace-footer .btn-primary {
    width: 100%;
  }

  .study-profile-grid {
    grid-template-columns: 1fr;
  }

  .study-profile-wide {
    grid-column: auto;
  }

  .study-profile-actions {
    flex-direction: column-reverse;
  }

  .study-profile-actions button {
    width: 100%;
  }

  .patch-export-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .patch-export-row button {
    grid-column: 1 / -1;
  }

  .subject-count {
    width: 100%;
    margin-left: 0;
  }

  .toast {
    bottom:
      calc(
        14px +
        var(--studiora-keyboard-offset, 0px)
      );

    max-width: calc(100vw - 24px);
  }

  .omni-box {
    bottom:
      calc(
        16px +
        var(--studiora-keyboard-offset, 0px)
      );

    width: calc(100vw - 14px);
    max-height: calc(100dvh - 20px);

    padding: 8px;
  }

  .omni-compose textarea {
    min-height: 58px;
  }

  /*
   * Omnibox chips wrap instead of scrolling.
   */
  .omni-modes {
    padding: 6px 0 1px;
  }

  .omni-response-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
}

/* =========================================================
   Responsive: <= 520px
   ========================================================= */

@media (max-width: 520px) {
  .form-row {
    flex-direction: column;
  }

  .header-right {
    gap: 4px;
  }

  .icon-btn {
    padding: 7px;
  }
}


/* =========================================================
   Omnibox Segmented Pill & Actions
   ========================================================= */
.omni-type-toggle {
  display: flex;
  align-self: center;
  gap: 3px;
  margin: 2px auto 8px;
  padding: 3px;
  background: var(--bg-color);
  border: 1px solid var(--border);
  border-radius: 999px;
}

.omni-type-tab {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 14px;
  background: transparent;
  color: var(--text-muted);
  border: 0;
  border-radius: 999px;
  font-size: 0.73rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.16s ease;
}

.omni-type-tab .material-symbols-outlined {
  font-size: 16px;
}

.omni-type-tab.active {
  background: var(--card-bg);
  color: var(--primary);
  box-shadow: var(--shadow-sm);
}

.omni-manual-actions {
  display: flex;
  gap: 8px;
  width: 100%;
  padding: 4px 0 2px;
}

.omni-manual-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
}

/* =========================================================
   Dedicated Modern Manual Workspace
   ========================================================= */
.manual-workspace-sheet {
  width: min(780px, 100%);
  max-height: 94vh;
  padding: 24px;
  overflow-y: auto;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 24px 24px 0 0;
  box-shadow: 0 28px 80px rgba(15, 23, 42, 0.3);
}

.manual-workspace-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.manual-workspace-title-box h2 {
  margin: 3px 0 2px;
  font-size: 1.25rem;
  font-weight: 700;
}

.manual-workspace-title-box p {
  color: var(--text-muted);
  font-size: 0.76rem;
}

.mw-section-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 16px;
  padding: 16px;
  background: var(--bg-color);
  border: 1px solid var(--border);
  border-radius: 18px;
}

.mw-section-head {
  display: flex;
  align-items: center;
  gap: 10px;
}

.mw-section-head > .material-symbols-outlined {
  color: var(--primary);
  font-size: 22px;
}

.mw-section-head div {
  flex: 1;
}

.mw-section-head strong {
  display: block;
  font-size: 0.88rem;
}

.mw-section-head p {
  margin: 2px 0 0;
  color: var(--text-muted);
  font-size: 0.72rem;
}

.mw-grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

@media (max-width: 600px) {
  .mw-grid-2 {
    grid-template-columns: 1fr;
  }
}

.mw-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mw-field span {
  color: var(--text-muted);
  font-size: 0.72rem;
  font-weight: 700;
}

.mw-field input,
.mw-field textarea,
.mw-field select,
.mw-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  background: var(--card-bg);
  color: var(--text-main);
  border: 1px solid var(--border);
  border-radius: 10px;
  font-size: 0.84rem;
  outline: none;
  font-family: inherit;
  transition: border-color 0.16s ease, box-shadow 0.16s ease;
}

.mw-field input:focus,
.mw-field textarea:focus,
.mw-field select:focus,
.mw-textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 14%, transparent);
}

.mw-dynamic-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.mw-item-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
}

.mw-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mw-item-head strong {
  font-size: 0.78rem;
  color: var(--primary);
}

.mw-mcq-options-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

@media (max-width: 600px) {
  .mw-mcq-options-grid {
    grid-template-columns: 1fr;
  }
}

.mw-mcq-opt-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.mw-visual-wrapper {
  margin-top: 6px;
}

.mw-visual-drawer {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 8px;
  padding: 10px;
  background: var(--bg-color);
  border: 1px dashed var(--border);
  border-radius: 12px;
}

.manual-workspace-bottom-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin-top: 20px;
}

.manual-workspace-bottom-actions .btn-lg {
  width: 100%;
  padding: 14px;
  font-size: 0.92rem;
  font-weight: 700;
  border-radius: 14px;
}

/* JSON Screen & Validator */
.manual-workspace-json-screen {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.manual-json-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.manual-json-meta strong {
  display: block;
  font-size: 0.9rem;
}

.manual-json-meta span {
  color: var(--text-muted);
  font-size: 0.72rem;
}

.manual-json-box-wrap {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.manual-json-box {
  width: 100%;
  box-sizing: border-box;
  padding: 12px;
  background: var(--bg-color);
  color: var(--text-main);
  border: 1px solid var(--border);
  border-radius: 12px;
  font-family: ui-monospace, Menlo, Monaco, monospace;
  font-size: 0.78rem;
  line-height: 1.5;
  outline: none;
}

.manual-json-status {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border-radius: 10px;
  font-size: 0.74rem;
  font-weight: 600;
}

.manual-json-status.pending {
  background: var(--bg-color);
  color: var(--text-muted);
  border: 1px solid var(--border);
}

.manual-json-status.valid {
  background: var(--success-bg);
  color: var(--success-text);
}

.manual-json-status.invalid {
  background: var(--danger-bg);
  color: var(--danger-text);
}

.manual-workspace-bottom-actions button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  pointer-events: none;
}


/* =========================================================
   Modern Profile Page & Grouped Sections
   ========================================================= */
.profile-page-shell {
  max-width: 820px;
  margin: 0 auto;
  padding: 10px 0 32px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px;
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--primary-light) 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.profile-hero-icon {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  color: var(--primary);
  display: grid;
  place-items: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.profile-hero-icon .material-symbols-outlined {
  font-size: 28px;
}

.profile-hero-content h2 {
  margin: 0 0 4px;
  font-size: 1.15rem;
  font-weight: 700;
}

.profile-hero-content p {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.8rem;
  line-height: 1.5;
}

.profile-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.profile-card-group {
  padding: 20px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.profile-group-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.profile-group-header .group-icon {
  color: var(--primary);
  font-size: 24px;
  margin-top: 1px;
}

.profile-group-header h3 {
  margin: 0;
  font-size: 0.96rem;
  font-weight: 700;
}

.profile-group-header p {
  margin: 2px 0 0;
  color: var(--text-muted);
  font-size: 0.74rem;
}

.profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

@media (max-width: 650px) {
  .profile-grid {
    grid-template-columns: 1fr;
  }
}

.profile-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.profile-field-full {
  grid-column: 1 / -1;
}

.profile-field label {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.profile-field label span {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--text-main);
}

.profile-field label small {
  font-size: 0.68rem;
  color: var(--text-muted);
}

.profile-field input {
  width: 100%;
  box-sizing: border-box;
  padding: 11px 14px;
  background: var(--bg-color);
  color: var(--text-main);
  border: 1px solid var(--border);
  border-radius: 12px;
  font-size: 0.85rem;
  outline: none;
  transition: border-color 0.16s ease, box-shadow 0.16s ease;
}

.profile-field input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 14%, transparent);
}

.optional-tag {
  font-size: 0.65rem;
  color: var(--text-muted);
  font-weight: normal;
  margin-left: 4px;
}

.profile-insight-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  background: var(--primary-light);
  border: 1px solid color-mix(in srgb, var(--primary) 24%, var(--border));
  border-radius: 14px;
}

.insight-icon {
  color: var(--primary);
  font-size: 22px;
  margin-top: 1px;
}

.insight-content strong {
  display: block;
  font-size: 0.8rem;
  color: var(--text-main);
}

.insight-content p {
  margin: 3px 0 0;
  color: var(--text-muted);
  font-size: 0.72rem;
  line-height: 1.45;
}

.profile-actions-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  padding-top: 4px;
}

.profile-actions-bar .btn-primary {
  padding: 12px 24px;
  font-weight: 700;
}

/* =========================================================
   Modular Explanation Blocks (Paragraphs, Tables, Headings)
   ========================================================= */
.mw-block-add-buttons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
}

.mw-body-block-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 14px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: var(--shadow-sm);
}

.mw-block-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--primary);
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.mw-block-tag .material-symbols-outlined {
  font-size: 17px;
}

.mw-heading-text {
  font-weight: 700;
  font-size: 0.95rem !important;
  color: var(--primary) !important;
}

.mw-table-headers {
  font-weight: 600;
}
